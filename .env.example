# SMTP transport for the contact form (app/contact/actions.ts).
# Without SMTP_HOST the form shows an error and points visitors to the company email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where contact messages are delivered, and the From address used to send them.
CONTACT_TO=info@noizejeans.com
CONTACT_FROM=noreply@noizejeans.com
